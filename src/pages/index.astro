<!-- ═══ FOOTER ═══════════════════════════════════════════════ -->
<footer>
  <div class="container foot-inner">
    <a href="/" class="footer-logo">
      <div class="logo-icon">
        <svg width="28" height="28" viewBox="0 0 40 40" fill="none">
          <defs><linearGradient id="ng2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4F6AFF"/><stop offset="100%" stop-color="#9B50FF"/></linearGradient></defs>
          <path d="M6 34V6l22 28V6" stroke="url(#ng2)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <path d="M18 6l16 28" stroke="#0F1322" stroke-width="5" stroke-linecap="round"/>
          <path d="M18 6l16 28" stroke="url(#ng2)" stroke-width="3" stroke-linecap="round"/>
          <circle cx="32" cy="8" r="2.5" fill="#9B50FF"/>
        </svg>
      </div>
      <div class="logo-text"><span class="logo-nova">NOVA</span><span class="logo-studio">STUDIO</span></div>
    </a>
    <p class="foot-copy">&copy; {new Date().getFullYear()} Nova Studio — Tous droits réservés</p>
    <a href="/portal" class="foot-portal">Portail client</a>
  </div>
</footer>

</Layout>

<script>
/* ══════════════════════════════════════════════════════════
   ANIMATIONS PREMIUM — Nova Studio
══════════════════════════════════════════════════════════ */

// ── 1. Cursor glow ────────────────────────────────────────
const glow = document.getElementById('cursor-glow');
if (glow) {
  let mx = window.innerWidth / 2, my = window.innerHeight / 2;
  let cx = mx, cy = my;
  document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; }, { passive: true });
  (function animGlow() {
    cx += (mx - cx) * 0.08;
    cy += (my - cy) * 0.08;
    glow.style.left = cx + 'px';
    glow.style.top  = cy + 'px';
    requestAnimationFrame(animGlow);
  })();
}

// ── 2. Scroll progress bar ────────────────────────────────
const scrollBar = document.getElementById('scroll-bar');
if (scrollBar) {
  window.addEventListener('scroll', () => {
    const pct = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
    scrollBar.style.transform = `scaleX(${Math.min(pct, 1)})`;
    scrollBar.style.width = '100%';
  }, { passive: true });
}

// ── 3. Hero title word-split reveal ──────────────────────
const heroTitle = document.getElementById('hero-title-split');
if (heroTitle) {
  let wordIdx = 0;

  const wrapWord = (text: string, delay: number) => {
    const wrap  = document.createElement('span');
    const inner = document.createElement('span');
    wrap.className  = 'hero-word-wrap';
    inner.className = 'hero-word-inner';
    inner.style.animationDelay = delay + 's';
    inner.textContent = text;
    wrap.appendChild(inner);
    return wrap;
  };

  const nodes = Array.from(heroTitle.childNodes);
  nodes.forEach(node => {
    if (node.nodeType === Node.TEXT_NODE) {
      const words = (node.textContent || '').trim().split(/\s+/).filter(Boolean);
      if (!words.length) { node.textContent = ''; return; }
      const frag = document.createDocumentFragment();
      words.forEach(word => {
        frag.appendChild(wrapWord(word, 0.35 + wordIdx * 0.12));
        frag.appendChild(document.createTextNode(' '));
        wordIdx++;
      });
      node.parentNode!.replaceChild(frag, node);

    } else if (node.nodeType === Node.ELEMENT_NODE && (node as Element).tagName !== 'BR') {
      // Animate the whole element (e.g. the gradient span) as one unit
      const el    = node as HTMLElement;
      const wrap  = document.createElement('span');
      const inner = document.createElement('span');
      wrap.className  = 'hero-word-wrap';
      inner.className = 'hero-word-inner';
      inner.style.animationDelay = (0.35 + wordIdx * 0.12) + 's';
      wordIdx += 3; // compte comme plusieurs mots
      inner.appendChild(el.cloneNode(true));
      wrap.appendChild(inner);
      el.parentNode!.replaceChild(wrap, el);
    }
  });
}

// ── 4. 3D card tilt ───────────────────────────────────────
document.querySelectorAll('.service-card, .project-card, .plan-card').forEach(el => {
  const card = el as HTMLElement;
  card.classList.add('tilt-card');
  card.addEventListener('mousemove', (e: Event) => {
    const ev      = e as MouseEvent;
    const rect    = card.getBoundingClientRect();
    const x       = (ev.clientX - rect.left) / rect.width  - 0.5;
    const y       = (ev.clientY - rect.top)  / rect.height - 0.5;
    card.style.transform = `perspective(900px) rotateX(${-y * 8}deg) rotateY(${x * 8}deg) translateY(-4px) scale(1.01)`;
    card.style.boxShadow = `${-x * 16}px ${-y * 16}px 40px rgba(79,106,255,0.12)`;
  });
  card.addEventListener('mouseleave', () => {
    card.style.transform = '';
    card.style.boxShadow = '';
    card.style.transition = 'transform 0.5s cubic-bezier(0.16,1,0.3,1), box-shadow 0.5s ease';
    setTimeout(() => { card.style.transition = ''; }, 500);
  });
});

// ── 5. Magnetic buttons ───────────────────────────────────
document.querySelectorAll('.magnet-btn').forEach(el => {
  const btn = el as HTMLElement;
  btn.addEventListener('mousemove', (e: Event) => {
    const ev   = e as MouseEvent;
    const rect = btn.getBoundingClientRect();
    const x    = (ev.clientX - rect.left - rect.width  / 2) * 0.28;
    const y    = (ev.clientY - rect.top  - rect.height / 2) * 0.28;
    btn.style.transform = `translate(${x}px, ${y}px)`;
  });
  btn.addEventListener('mouseleave', () => {
    btn.style.transform = '';
    btn.style.transition = 'transform 0.5s cubic-bezier(0.16,1,0.3,1)';
    setTimeout(() => { btn.style.transition = ''; }, 500);
  });
});

// ── 6. Counter animation ──────────────────────────────────
const counters = document.querySelectorAll('.counter');
if (counters.length) {
  const runCounter = (el: Element) => {
    const target = parseInt((el as HTMLElement).dataset.target || '0');
    const suffix = (el as HTMLElement).dataset.suffix || '';
    const dur    = 1600;
    const start  = performance.now();
    const tick   = (now: number) => {
      const p   = Math.min((now - start) / dur, 1);
      const ease = 1 - Math.pow(1 - p, 3);
      (el as HTMLElement).textContent = Math.round(ease * target) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const cObs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { runCounter(e.target); cObs.unobserve(e.target); } });
  }, { threshold: 0.5 });
  counters.forEach(c => cObs.observe(c));
}

// ── 7. Parallax hero orbs on scroll ──────────────────────
const orb1 = document.querySelector('.hero-orb-1') as HTMLElement | null;
const orb2 = document.querySelector('.hero-orb-2') as HTMLElement | null;
if (orb1 && orb2) {
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    orb1.style.transform = `translateY(${y * 0.25}px)`;
    orb2.style.transform = `translateY(${y * 0.15}px)`;
  }, { passive: true });
}
</script>

