---
import Layout from '../layouts/Layout.astro';

const services = [
  { icon: '🌐', title: 'Sites vitrines', desc: 'Des sites élégants qui reflètent votre marque et convertissent vos visiteurs en clients.', tags: ['Design custom', 'SEO', 'Responsive'] },
  { icon: '🛒', title: 'Boutiques en ligne', desc: 'Des e-commerces performants avec gestion des produits, paiements et commandes.', tags: ['Catalogue', 'Paiement', 'Gestion stocks'] },
  { icon: '🎮', title: 'Sites communautaires', desc: 'Portails gaming, serveurs FiveM, classements live et espaces membres dédiés.', tags: ['FiveM', 'Leaderboards', 'Membres'] },
  { icon: '📊', title: 'Tableaux de bord', desc: 'Interfaces sur mesure pour visualiser vos données et piloter votre activité en temps réel.', tags: ['API live', 'Analytics', 'Export'] },
  { icon: '🔐', title: 'Portails clients', desc: 'Espaces sécurisés pour que vos clients accèdent à leurs documents, factures et projets.', tags: ['Auth', 'Facturation', 'Sécurisé'] },
  { icon: '⚡', title: 'Landing pages', desc: 'Pages de conversion optimisées pour vos campagnes publicitaires et lancements de produit.', tags: ['Conversion', 'Performance', 'A/B ready'] },
];

const steps = [
  { num: '01', title: 'Découverte', desc: 'On discute de votre projet, vos objectifs et votre audience cible lors d\'un appel rapide.' },
  { num: '02', title: 'Conception', desc: 'Je conçois la maquette et vous la soumets pour validation avant de coder quoi que ce soit.' },
  { num: '03', title: 'Développement', desc: 'Développement complet avec mises à jour régulières et accès à un lien de prévisualisation.' },
  { num: '04', title: 'Livraison', desc: 'Mise en ligne, formation rapide et support post-lancement inclus dans chaque projet.' },
];

const projects = [
  { cat: 'Entreprise locale', title: 'Site vitrine corporatif', desc: 'Site institutionnel avec animations, blog et formulaire de contact.', tags: ['Astro', 'Animations', 'SEO'] },
  { cat: 'Serveur FiveM', title: 'Portail roleplay', desc: 'Site communautaire avec règlement, candidatures et galerie médias.', tags: ['Community', 'Forms', 'Gallery'] },
  { cat: 'Artisanat', title: 'Boutique impression 3D', desc: 'Galerie produits avec panel admin, commandes et suivi client.', tags: ['Admin', 'Suivi', 'Galerie'] },
  { cat: 'Casino / Streaming', title: 'Wagger Race live', desc: 'Classement en temps réel connecté à une API affiliée avec mise à jour automatique.', tags: ['API live', 'Realtime', 'Cache'] },
  { cat: 'Photographie', title: 'Portfolio photographe', desc: 'Site élégant avec galerie masonry, SEO et formulaire de contact.', tags: ['Portfolio', 'SEO', 'Responsive'] },
  { cat: 'Agence web', title: 'Nova Studio', desc: 'Ce site — portail client intégré, facturation et espace admin.', tags: ['Portail', 'Facturation', 'Admin'] },
];

---
<Layout>

<!-- ═══ NAV ═════════════════════════════════════════════════ -->
<header id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <div class="logo-icon">
        <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
          <defs><linearGradient id="ng" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4F6AFF"/><stop offset="100%" stop-color="#9B50FF"/></linearGradient></defs>
          <path d="M6 34V6l22 28V6" stroke="url(#ng)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <path d="M18 6l16 28" stroke="#0F1322" stroke-width="5" stroke-linecap="round"/>
          <path d="M18 6l16 28" stroke="url(#ng)" stroke-width="3" stroke-linecap="round"/>
          <circle cx="32" cy="8" r="2.5" fill="#9B50FF"/>
        </svg>
      </div>
      <div class="logo-text">
        <span class="logo-nova">NOVA</span>
        <span class="logo-studio">STUDIO</span>
      </div>
    </a>

    <nav class="nav-links">
      <a href="#services">Services</a>
      <a href="#portfolio">Portfolio</a>
      <a href="#processus">Processus</a>
      <a href="#tarifs">Tarifs</a>
    </nav>

    <div class="nav-right">
      <a href="/portal" class="nav-portal">Portail client</a>
      <a href="#contact" class="nav-cta">Démarrer un projet</a>
    </div>

    <button id="burger" class="burger" aria-label="Menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<div id="mobile-nav" class="mobile-nav">
  <a href="#services">Services</a>
  <a href="#portfolio">Portfolio</a>
  <a href="#processus">Processus</a>
  <a href="#tarifs">Tarifs</a>
  <a href="/portal" class="mn-portal">Portail client</a>
  <a href="#contact" class="mn-cta">Démarrer un projet →</a>
</div>

<!-- ═══ HERO ════════════════════════════════════════════════ -->
<section class="hero">
  <div class="hero-noise"></div>
  <div class="hero-orb hero-orb-1"></div>
  <div class="hero-orb hero-orb-2"></div>

  <div class="container hero-inner">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      Disponible pour de nouveaux projets
    </div>
    <h1 class="hero-title">
      Des sites web qui<br/>
      <span class="text-gradient">font la différence</span>
    </h1>
    <p class="hero-sub">
      Nova Studio crée des expériences web sur mesure qui propulsent votre marque, engagent vos clients et génèrent des résultats concrets.
    </p>
    <div class="hero-actions">
      <a href="#contact" class="btn-primary btn-lg">
        Démarrer mon projet
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#portfolio" class="btn-ghost btn-lg">Voir les réalisations</a>
    </div>
    <div class="hero-stats">
      <div class="hstat"><span class="hstat-n">20+</span><span class="hstat-l">Projets livrés</span></div>
      <div class="hstat-sep"></div>
      <div class="hstat"><span class="hstat-n">100%</span><span class="hstat-l">Clients satisfaits</span></div>
      <div class="hstat-sep"></div>
      <div class="hstat"><span class="hstat-n">7j</span><span class="hstat-l">Délai moyen</span></div>
    </div>
  </div>

  <div class="hero-scroll">
    <span class="scroll-line"></span>
    <p>Défiler</p>
  </div>
</section>

<!-- ═══ SERVICES ═════════════════════════════════════════════ -->
<section class="section section-light" id="services">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Ce que je fais</p>
      <h2>Des solutions pour <span class="text-gradient">chaque besoin</span></h2>
      <p class="section-sub">De la landing page simple à l'application web complexe, je couvre l'ensemble du spectre du développement web.</p>
    </div>

    <div class="services-grid">
      {services.map((s, i) => (
        <div class="service-card reveal" style={`transition-delay:${i * 0.07}s`}>
          <div class="sc-icon">{s.icon}</div>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          <div class="sc-tags">
            {s.tags.map(t => <span class="sc-tag">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ PROCESSUS ════════════════════════════════════════════ -->
<section class="section section-dark" id="processus">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow eyebrow-light">Comment on travaille</p>
      <h2 style="color:#fff">Un processus <span class="text-gradient">simple et efficace</span></h2>
    </div>

    <div class="steps-grid">
      {steps.map((s, i) => (
        <div class="step-card reveal" style={`transition-delay:${i * 0.1}s`}>
          <span class="step-num">{s.num}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          {i < steps.length - 1 && <div class="step-arrow">→</div>}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ PORTFOLIO ════════════════════════════════════════════ -->
<section class="section section-light" id="portfolio">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Réalisations récentes</p>
      <h2>Quelques <span class="text-gradient">projets récents</span></h2>
    </div>

    <div class="projects-grid">
      {projects.map((p, i) => (
        <div class="project-card reveal" style={`transition-delay:${i * 0.08}s`}>
          <div class="pc-header">
            <span class="pc-cat">{p.cat}</span>
          </div>
          <div class="pc-body">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <div class="pc-tags">
              {p.tags.map(t => <span class="pc-tag">{t}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ TARIFS ══════════════════════════════════════════════ -->
<section class="section section-bg" id="tarifs">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Investissement</p>
      <h2>Tarification <span class="text-gradient">sur demande</span></h2>
      <p class="section-sub">Chaque projet est unique. Décrivez-moi votre vision et je vous propose une solution adaptée à vos besoins et à votre budget.</p>
    </div>

    <div class="single-plan reveal">
      <div class="sp-left">
        <div class="sp-icon">💬</div>
        <div>
          <h3>Devis personnalisé gratuit</h3>
          <p>Pas de forfaits rigides — je préfère comprendre votre projet avant de vous proposer un prix juste. Envoyez-moi votre idée et je reviens vers vous sous 24h avec une proposition sur mesure.</p>
        </div>
      </div>
      <div class="sp-features">
        <div class="sp-feat"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Analyse gratuite de vos besoins</div>
        <div class="sp-feat"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Devis détaillé sans engagement</div>
        <div class="sp-feat"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Prix ajusté à votre budget</div>
        <div class="sp-feat"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Réponse en moins de 24h</div>
      </div>
      <a href="#contact" class="btn-primary btn-lg">Demander un devis</a>
    </div>
  </div>
</section>

<!-- ═══ CONTACT ══════════════════════════════════════════════ -->
<section class="section section-light" id="contact">
  <div class="container">
    <div class="contact-inner reveal">
      <div class="contact-left">
        <p class="eyebrow">Parlons de votre projet</p>
        <h2>Prêt à lancer <span class="text-gradient">votre site ?</span></h2>
        <p>Décrivez votre projet et je vous réponds avec un devis personnalisé dans les 24 heures.</p>
        <div class="contact-infos">
          <div class="ci">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span>contact@nova-studio.ca</span>
          </div>
          <div class="ci">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 13 8 13s8-7.75 8-13a8 8 0 0 0-8-8z"/></svg>
            <span>Québec, Canada · Remote partout</span>
          </div>
        </div>
      </div>

      <form class="contact-form" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="9ab420c1-4542-4cb7-b83e-77dd07196e51" />
        <input type="hidden" name="subject" value="Nouveau projet — Nova Studio" />
        <input type="checkbox" name="botcheck" style="display:none" />

        <div class="form-row">
          <div class="field">
            <label>Nom <span class="req">*</span></label>
            <input type="text" name="name" placeholder="Jean Tremblay" required />
          </div>
          <div class="field">
            <label>Courriel <span class="req">*</span></label>
            <input type="email" name="email" placeholder="jean@exemple.com" required />
          </div>
        </div>
        <div class="field">
          <label>Type de projet <span class="req">*</span></label>
          <select name="type" required>
            <option value="" disabled selected>Choisir...</option>
            <option>Site vitrine</option>
            <option>Boutique en ligne</option>
            <option>Site communautaire / gaming</option>
            <option>Tableau de bord / portail</option>
            <option>Landing page</option>
            <option>Autre</option>
          </select>
        </div>
        <div class="field">
          <label>Décrivez votre projet <span class="req">*</span></label>
          <textarea name="message" rows="4" placeholder="Parlez-moi de votre projet, votre budget approximatif, vos délais..." required></textarea>
        </div>
        <button type="submit" class="btn-primary btn-full" id="submit-btn">
          <span id="btn-text">Envoyer ma demande</span>
          <span id="btn-spin" style="display:none">Envoi...</span>
        </button>
      </form>
    </div>

    <div id="success-msg" class="success-msg" style="display:none">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="20 6 9 17 4 12"/></svg>
      <h3>Message envoyé !</h3>
      <p>Je vous réponds dans les 24 heures avec une proposition personnalisée.</p>
    </div>
  </div>
</section>

<!-- ═══ FOOTER ═══════════════════════════════════════════════ -->
<footer>
  <div class="container foot-inner">
    <a href="/" class="footer-logo">
      <div class="logo-icon">
        <svg width="28" height="28" viewBox="0 0 40 40" fill="none">
          <defs><linearGradient id="ng2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4F6AFF"/><stop offset="100%" stop-color="#9B50FF"/></linearGradient></defs>
          <path d="M6 34V6l22 28V6" stroke="url(#ng2)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <path d="M18 6l16 28" stroke="#0F1322" stroke-width="5" stroke-linecap="round"/>
          <path d="M18 6l16 28" stroke="url(#ng2)" stroke-width="3" stroke-linecap="round"/>
          <circle cx="32" cy="8" r="2.5" fill="#9B50FF"/>
        </svg>
      </div>
      <div class="logo-text"><span class="logo-nova">NOVA</span><span class="logo-studio">STUDIO</span></div>
    </a>
    <p class="foot-copy">&copy; {new Date().getFullYear()} Nova Studio — Tous droits réservés</p>
    <a href="/portal" class="foot-portal">Portail client</a>
  </div>
</footer>

</Layout>

<script>
  // Nav scroll
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => nav?.classList.toggle('scrolled', window.scrollY > 20), { passive: true });

  // Burger
  const burger = document.getElementById('burger');
  const mNav   = document.getElementById('mobile-nav');
  burger?.addEventListener('click', () => mNav?.classList.toggle('open'));
  mNav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mNav.classList.remove('open')));

  // Contact form
  const form    = document.getElementById('contact-form');
  const btnText = document.getElementById('btn-text');
  const btnSpin = document.getElementById('btn-spin');
  const submitBtn = document.getElementById('submit-btn');
  const success = document.getElementById('success-msg');

  form?.addEventListener('submit', async e => {
    e.preventDefault();
    if (submitBtn) { submitBtn.disabled = true; }
    if (btnText) btnText.style.display = 'none';
    if (btnSpin) btnSpin.style.display = 'inline';
    try {
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(form as HTMLFormElement) });
      if (res.ok) {
        if (form) form.style.display = 'none';
        if (success) success.style.display = 'flex';
      }
    } catch {}
    if (submitBtn) { submitBtn.disabled = false; }
    if (btnText) btnText.style.display = 'inline';
    if (btnSpin) btnSpin.style.display = 'none';
  });
</script>

<style>
  /* ── NAV ────────────────────────────────────────────── */
  #nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(248,250,255,0.88); backdrop-filter: blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  #nav.scrolled { border-bottom-color: var(--border); box-shadow: 0 4px 24px rgba(79,106,255,0.06); }
  .nav-inner {
    max-width: 1160px; margin: 0 auto;
    display: flex; align-items: center; gap: 2rem;
    padding: 0 2rem; height: 70px;
  }
  .nav-logo { display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0; }
  .logo-icon { display: flex; }
  .logo-text { display: flex; flex-direction: column; line-height: 1; }
  .logo-nova   { font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem; font-weight: 700; color: var(--navy); letter-spacing: 0.1em; }
  .logo-studio { font-size: 0.58rem; font-weight: 500; color: var(--blue); letter-spacing: 0.18em; margin-top: 1px; }
  .nav-links { display: flex; gap: 0.25rem; margin-left: auto; }
  .nav-links a { padding: 0.5rem 0.9rem; font-size: 0.875rem; font-weight: 500; color: var(--text-2); border-radius: 8px; transition: color 0.2s, background 0.2s; }
  .nav-links a:hover { color: var(--text); background: rgba(79,106,255,0.06); }
  .nav-right { display: flex; align-items: center; gap: 0.75rem; }
  .nav-portal { font-size: 0.875rem; font-weight: 500; color: var(--blue); transition: opacity 0.2s; }
  .nav-portal:hover { opacity: 0.7; }
  .nav-cta { background: var(--gradient); color: #fff; padding: 0.55rem 1.25rem; border-radius: 10px; font-size: 0.85rem; font-weight: 600; transition: opacity 0.2s, transform 0.2s; box-shadow: 0 4px 14px rgba(79,106,255,0.3); }
  .nav-cta:hover { opacity: 0.9; transform: translateY(-1px); }
  .burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; padding: 4px; margin-left: auto; }
  .burger span { display: block; width: 20px; height: 2px; background: var(--navy); border-radius: 2px; }
  .mobile-nav { display: none; position: fixed; top: 70px; left: 0; right: 0; z-index: 99; background: #fff; border-bottom: 1px solid var(--border); flex-direction: column; padding: 1rem 2rem 1.5rem; gap: 0.3rem; box-shadow: 0 8px 24px rgba(15,19,34,0.06); }
  .mobile-nav.open { display: flex; }
  .mobile-nav a { padding: 0.65rem 0; font-size: 0.95rem; font-weight: 500; color: var(--text-2); border-bottom: 1px solid var(--border); }
  .mobile-nav a:last-child { border-bottom: none; }
  .mn-cta { background: var(--gradient); color: #fff !important; padding: 0.8rem 1.25rem; border-radius: 10px; text-align: center; margin-top: 0.5rem; font-weight: 600; border: none !important; }
  .mn-portal { color: var(--blue) !important; font-weight: 500; }
  @media (max-width: 900px) { .nav-links, .nav-right { display: none; } .burger { display: flex; } }

  /* ── HERO ────────────────────────────────────────────── */
  .hero {
    position: relative; min-height: 100vh;
    background: var(--navy); overflow: hidden;
    display: flex; align-items: center;
    padding: 80px 0 0;
  }
  .hero-noise {
    position: absolute; inset: 0; opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 256px;
  }
  .hero-orb {
    position: absolute; border-radius: 50%; pointer-events: none;
    filter: blur(80px); animation: float 8s ease infinite;
  }
  .hero-orb-1 { width: 500px; height: 500px; background: rgba(79,106,255,0.18); top: -100px; right: -100px; }
  .hero-orb-2 { width: 400px; height: 400px; background: rgba(155,80,255,0.14); bottom: -80px; left: -60px; animation-delay: -4s; }

  .hero-inner { position: relative; text-align: center; }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(79,106,255,0.12); border: 1px solid rgba(79,106,255,0.25);
    border-radius: 999px; padding: 0.4rem 1rem; margin-bottom: 2rem;
    font-size: 0.78rem; font-weight: 600; color: #A0B0FF; letter-spacing: 0.06em;
  }
  .badge-dot { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 8px #4ade80; animation: float 2s ease infinite; }
  .hero-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    font-weight: 700; color: #fff;
    line-height: 1.1; margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }
  .hero-sub { font-size: 1.05rem; color: rgba(255,255,255,0.55); max-width: 560px; margin: 0 auto 2.5rem; line-height: 1.75; }
  .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 4rem; }
  .hero-stats { display: flex; align-items: center; justify-content: center; gap: 2rem; }
  .hstat { display: flex; flex-direction: column; align-items: center; }
  .hstat-n { font-family: 'Space Grotesk', sans-serif; font-size: 1.6rem; font-weight: 700; background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .hstat-l { font-size: 0.75rem; color: rgba(255,255,255,0.4); letter-spacing: 0.05em; margin-top: 2px; }
  .hstat-sep { width: 1px; height: 36px; background: rgba(255,255,255,0.1); }
  .hero-scroll { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .scroll-line { width: 1px; height: 48px; background: linear-gradient(to bottom, rgba(255,255,255,0.3), transparent); }
  .hero-scroll p { font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.25); }

  /* ── BUTTONS ─────────────────────────────────────────── */
