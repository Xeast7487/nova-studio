    </div>
    <div id="reviews-summary" class="reviews-summary" style="display:none">
      <div class="rs-score" id="rs-score">5.0</div>
      <div class="rs-sep"></div>
      <div class="rs-right">
        <div class="rs-stars" id="rs-stars">★★★★★</div>
        <div class="rs-count" id="rs-count">0 avis</div>
      </div>
      <div class="rs-sep"></div>
