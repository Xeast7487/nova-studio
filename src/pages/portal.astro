---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Portail client — Nova Studio">
<main>

  <!-- LOGIN -->
  <div id="login-screen" class="login-wrap">
    <div class="login-left">
      <div class="ll-content">
        <div class="ll-logo">
          <svg width="44" height="44" viewBox="0 0 40 40" fill="none">
            <defs><linearGradient id="pg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4F6AFF"/><stop offset="100%" stop-color="#9B50FF"/></linearGradient></defs>
            <path d="M6 34V6l22 28V6" stroke="url(#pg)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18 6l16 28" stroke="rgba(255,255,255,0.12)" stroke-width="5" stroke-linecap="round"/>
            <path d="M18 6l16 28" stroke="url(#pg)" stroke-width="3" stroke-linecap="round"/>
            <circle cx="32" cy="8" r="2.5" fill="#9B50FF"/>
          </svg>
          <div><span class="ll-nova">NOVA</span><span class="ll-studio">STUDIO</span></div>
        </div>
        <h1>Votre espace client</h1>
        <p>Consultez vos factures, suivez vos projets et téléchargez vos documents en toute sécurité.</p>
        <div class="ll-perks">
          <div class="llp"><span class="llp-icon">📄</span><span>Accès à toutes vos factures</span></div>
          <div class="llp"><span class="llp-icon">🔒</span><span>Espace sécurisé et privé</span></div>
          <div class="llp"><span class="llp-icon">🖨️</span><span>Impression et export PDF</span></div>
        </div>
      </div>
    </div>
    <div class="login-right">
      <div class="login-form-wrap">
        <div class="login-form-head">
          <h2>Connexion</h2>
          <p>Entrez vos identifiants fournis par Nova Studio</p>
        </div>
        <form id="login-form">
          <div class="lf-field">
            <label>Adresse courriel</label>
            <div class="lf-input-wrap">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <input type="email" id="login-email" placeholder="vous@exemple.com" required autocomplete="email" />
            </div>
          </div>
          <div class="lf-field">
            <label>Mot de passe</label>
            <div class="lf-input-wrap">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <input type="password" id="login-pwd" placeholder="••••••••" required autocomplete="current-password" />
            </div>
          </div>
          <p id="login-err" class="lf-err"></p>
          <button type="submit" class="lf-btn" id="login-btn">
            <span>Se connecter</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>
        <a href="/" class="lf-back">← Retour au site Nova Studio</a>
      </div>
    </div>
  </div>

  <!-- PORTAL APP -->
  <div id="portal-app" style="display:none" class="portal-app">

    <!-- HEADER -->
    <header class="portal-header">
      <div class="ph-inner">
        <a href="/" class="ph-logo">
          <svg width="28" height="28" viewBox="0 0 40 40" fill="none">
            <defs><linearGradient id="pg2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4F6AFF"/><stop offset="100%" stop-color="#9B50FF"/></linearGradient></defs>
            <path d="M6 34V6l22 28V6" stroke="url(#pg2)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18 6l16 28" stroke="#0F1322" stroke-width="5" stroke-linecap="round"/>
            <path d="M18 6l16 28" stroke="url(#pg2)" stroke-width="3" stroke-linecap="round"/>
            <circle cx="32" cy="8" r="2.5" fill="#9B50FF"/>
          </svg>
          <div><span class="ph-nova">NOVA</span><span class="ph-studio">STUDIO</span></div>
        </a>
        <div class="ph-right">
          <div class="ph-user-badge" id="ph-user-badge">
            <div class="pub-avatar" id="pub-avatar">?</div>
            <div class="pub-info">
              <p class="pub-name" id="pub-name">Chargement...</p>
              <p class="pub-company" id="pub-company"></p>
            </div>
          </div>
          <button id="portal-logout" class="ph-logout">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Déconnexion
          </button>
        </div>
      </div>
    </header>

    <!-- DASHBOARD -->
    <div class="portal-body">

      <!-- LISTE FACTURES -->
      <div id="portal-dashboard">
        <div class="dash-head">
          <div>
            <h1>Mes factures</h1>
            <p class="dash-sub" id="dash-sub">Bienvenue dans votre espace client</p>
          </div>
        </div>
        <div class="dash-stats" id="portal-stats"></div>

        <!-- BANDEAU AVIS -->
        <div id="review-banner" style="display:none" class="review-banner">
          <div class="rb-left">
            <span class="rb-icon">⭐</span>
            <div>
              <p class="rb-title">Partagez votre expérience</p>
              <p class="rb-sub">Votre avis aide d'autres clients à nous faire confiance.</p>
            </div>
          </div>
          <button id="open-review-modal" class="rb-btn">Laisser un avis →</button>
        </div>

        <div id="portal-invoices" class="invoices-list"></div>
      </div>

      <!-- DETAIL FACTURE -->
      <div id="invoice-detail" style="display:none" class="inv-detail-wrap">
        <div class="inv-detail-toolbar">
          <button id="back-to-list" class="back-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            Retour aux factures
          </button>
          <button class="print-btn" onclick="window.print()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Imprimer / PDF
          </button>
        </div>

        <div id="invoice-print-zone" class="inv-doc">
          <!-- EN-TÊTE -->
          <div class="inv-doc-top">
            <div class="inv-doc-logo">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                <defs><linearGradient id="pg3" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4F6AFF"/><stop offset="100%" stop-color="#9B50FF"/></linearGradient></defs>
                <path d="M6 34V6l22 28V6" stroke="url(#pg3)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M18 6l16 28" stroke="#0F1322" stroke-width="5" stroke-linecap="round"/>
                <path d="M18 6l16 28" stroke="url(#pg3)" stroke-width="3" stroke-linecap="round"/>
                <circle cx="32" cy="8" r="2.5" fill="#9B50FF"/>
              </svg>
              <div><span class="inv-logo-n">NOVA</span><span class="inv-logo-s">STUDIO</span></div>
            </div>
            <div class="inv-doc-meta">
              <h2 class="inv-doc-title">FACTURE</h2>
              <p id="inv-doc-number" class="inv-doc-number"></p>
              <div id="inv-doc-status" class="inv-doc-status"></div>
            </div>
          </div>

          <!-- PARTIES -->
          <div class="inv-parties">
            <div class="inv-party">
              <p class="ip-label">De</p>
              <p class="ip-name">Nova Studio</p>
              <p class="ip-info">contact@nova-studio.ca</p>
              <p class="ip-info">Québec, Canada</p>
            </div>
            <div class="inv-party">
              <p class="ip-label">Facturer à</p>
              <p class="ip-name" id="inv-client-name"></p>
              <p class="ip-info" id="inv-client-company"></p>
              <p class="ip-info" id="inv-client-email"></p>
            </div>
            <div class="inv-party">
              <p class="ip-label">Dates</p>
              <div class="ip-dates">
                <div class="ipd-row"><span>Émise le</span><strong id="inv-doc-date"></strong></div>
                <div class="ipd-row"><span>Échéance</span><strong id="inv-doc-due"></strong></div>
              </div>
            </div>
          </div>

          <!-- TITRE DE LA FACTURE -->
          <div class="inv-title-block">
            <p class="itb-label">Objet</p>
            <p class="itb-val" id="inv-title-display"></p>
          </div>

          <!-- LIGNES -->
          <table class="inv-table">
            <thead>
              <tr>
                <th>Description</th>
                <th class="th-center">Qté</th>
                <th class="th-right">Prix unit.</th>
                <th class="th-right">Total</th>
              </tr>
            </thead>
            <tbody id="inv-items-body"></tbody>
          </table>

          <!-- TOTAUX -->
          <div class="inv-totals">
            <div class="it-row"><span>Sous-total</span><span id="inv-t-sub"></span></div>
            <div class="it-row it-sub" id="inv-t-tps-row"><span>TPS (5 %)</span><span id="inv-t-tps"></span></div>
            <div class="it-row it-sub" id="inv-t-tvq-row"><span>TVQ (9,975 %)</span><span id="inv-t-tvq"></span></div>
            <div class="it-row it-grand"><span>Total à payer</span><strong id="inv-t-total"></strong></div>
          </div>

          <!-- NOTES -->
          <div id="inv-notes-block" class="inv-notes" style="display:none">
            <p class="inv-notes-label">Notes</p>
            <p id="inv-notes-text" class="inv-notes-text"></p>
          </div>

          <div class="inv-footer">Merci de votre confiance · Nova Studio · contact@nova-studio.ca</div>
        </div>
      </div>

    </div>
  </div>

</main>

<!-- MODAL AVIS -->
<div id="review-modal" class="review-modal-overlay" style="display:none">
  <div class="review-modal-box">
    <div class="rm-head" id="rm-head">
      <div>
        <h3>Partagez votre expérience</h3>
        <p>Votre avis sera publié sur notre site après validation.</p>
      </div>
      <button id="close-review-modal" class="rm-close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="rm-rating-block" id="rm-rating-block">
      <p class="rm-label">Votre note <span class="req">*</span></p>
      <div class="star-selector">
        <button type="button" class="star" data-val="1">★</button>
        <button type="button" class="star" data-val="2">★</button>
        <button type="button" class="star" data-val="3">★</button>
        <button type="button" class="star" data-val="4">★</button>
        <button type="button" class="star" data-val="5">★</button>
      </div>
      <p class="rm-rating-label" id="rating-label">Choisissez une note</p>
    </div>
    <div class="rm-field" id="rm-field">
      <label>Votre commentaire <span class="req">*</span></label>
      <textarea id="review-comment" rows="4" placeholder="Décrivez votre expérience avec Nova Studio..." maxlength="500"></textarea>
      <p class="rm-char-count"><span id="char-count">0</span> / 500</p>
    </div>
    <p id="review-err" class="rm-err"></p>
    <div class="rm-foot" id="rm-foot">
      <button id="cancel-review" class="rm-btn-ghost">Annuler</button>
      <button id="submit-review" class="rm-btn-submit">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Publier mon avis
      </button>
    </div>
    <div id="review-success" class="rm-success" style="display:none">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="20 6 9 17 4 12"/></svg>
      <h4>Merci pour votre avis !</h4>
      <p>Il sera publié sur notre site après validation par Nova Studio.</p>
    </div>
  </div>
</div>

</Layout>

<script>
import { createClient } from '@supabase/supabase-js';
const sb = createClient(
  'https://gnpjilwdehxsafdqdtak.supabase.co',
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImducGppbHdkZWh4c2FmZHFkdGFrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk5Nzk3NjIsImV4cCI6MjA5NTU1NTc2Mn0.iFYR9r5ZZsKcc9n2N8jPtFTLs0QDTIqR3KMCMhCdSdA'
);

const fmt     = (n: number) => n.toLocaleString('fr-CA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' $';
const fmtDate = (d: string | null) => d ? new Date(d).toLocaleDateString('fr-CA', { day: 'numeric', month: 'long', year: 'numeric' }) : '—';
const STATUS: Record<string,{label:string;cls:string}> = {
  pending:   { label: 'En attente',  cls: 'sp-pending' },
  paid:      { label: 'Payée',       cls: 'sp-paid'    },
  overdue:   { label: 'En retard',   cls: 'sp-overdue' },
  cancelled: { label: 'Annulée',     cls: 'sp-cancelled' },
};

const saved = localStorage.getItem('nova-portal-client');
if (saved) showApp(JSON.parse(saved));

document.getElementById('login-form')?.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = document.getElementById('login-btn') as HTMLButtonElement;
  const err = document.getElementById('login-err')!;
  btn.disabled = true;
  btn.querySelector('span')!.textContent = 'Connexion...';
  err.textContent = '';
  const email = (document.getElementById('login-email') as HTMLInputElement).value.trim().toLowerCase();
  const pwd   = (document.getElementById('login-pwd')   as HTMLInputElement).value;
  try {
    const res  = await fetch('/api/nova-auth', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password: pwd }) });
    const data = await res.json();
    if (!res.ok) err.textContent = data.error || 'Identifiants invalides';
    else { localStorage.setItem('nova-portal-client', JSON.stringify(data)); showApp(data); }
  } catch { err.textContent = 'Erreur de connexion'; }
  btn.disabled = false;
  btn.querySelector('span')!.textContent = 'Se connecter';
});

document.getElementById('portal-logout')?.addEventListener('click', () => { localStorage.removeItem('nova-portal-client'); location.reload(); });
document.getElementById('back-to-list')?.addEventListener('click', () => {
  document.getElementById('invoice-detail')!.style.display = 'none';
  document.getElementById('portal-dashboard')!.style.display = 'block';
});

async function showApp(client: any) {
  document.getElementById('login-screen')!.style.display  = 'none';
  document.getElementById('portal-app')!.style.display    = 'block';

  // Header user info
  const avatar = client.name.charAt(0).toUpperCase();
  const avatarEl = document.getElementById('pub-avatar'); if (avatarEl) avatarEl.textContent = avatar;
  const nameEl   = document.getElementById('pub-name');   if (nameEl)   nameEl.textContent   = client.name;
  const compEl   = document.getElementById('pub-company'); if (compEl)   compEl.textContent   = client.company || '';
  const subEl    = document.getElementById('dash-sub');   if (subEl)    subEl.textContent    = `Bonjour ${client.name}${client.company ? ` · ${client.company}` : ''} 👋`;

  const { data: invoices } = await sb.from('nova_invoices').select('*').eq('client_id', client.id).order('created_at', { ascending: false });
  const invs = invoices || [];
  (window as any)._invoices = invs;
  (window as any)._client   = client;

  // Vérification facture payée → avis possible
  const hasPaid = invs.some((i: any) => i.status === 'paid');
  if (hasPaid) {
    const { data: existing } = await sb.from('nova_reviews').select('id').eq('client_id', client.id).limit(1);
    if (!existing || existing.length === 0) {
      const banner = document.getElementById('review-banner');
      if (banner) banner.style.display = 'flex';
    }
  }

  // Stats
  const pending = invs.filter((i:any) => i.status === 'pending').reduce((s:number, i:any) => s + parseFloat(i.total), 0);
  const paid    = invs.filter((i:any) => i.status === 'paid').reduce((s:number, i:any) => s + parseFloat(i.total), 0);
  const statsEl = document.getElementById('portal-stats');
  if (statsEl) statsEl.innerHTML = `
    <div class="ds-card"><div class="dsc-icon dsc-blue"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div><div><p class="dsc-val">${invs.length}</p><p class="dsc-lbl">Factures</p></div></div>
    <div class="ds-card"><div class="dsc-icon dsc-amber"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><div><p class="dsc-val">${fmt(pending)}</p><p class="dsc-lbl">En attente</p></div></div>
    <div class="ds-card"><div class="dsc-icon dsc-green"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><div><p class="dsc-val">${fmt(paid)}</p><p class="dsc-lbl">Payé</p></div></div>
  `;

  // List
  const listEl = document.getElementById('portal-invoices');
  if (!listEl) return;
  if (!invs.length) {
    listEl.innerHTML = '<div class="empty-inv"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><p>Aucune facture pour l\'instant</p><small>Vos factures apparaîtront ici dès qu\'elles seront créées.</small></div>';
    return;
  }
  listEl.innerHTML = `
    <div class="inv-list-header">
      <span>Numéro</span><span>Description</span><span>Date</span><span>Statut</span><span>Montant</span><span></span>
    </div>
    ${invs.map((inv:any) => `
      <div class="inv-list-row" onclick="viewInvoice('${inv.id}')">
        <span class="ilr-num">${inv.invoice_number}</span>
        <span class="ilr-title">${inv.title}</span>
        <span class="ilr-date">${fmtDate(inv.created_at)}</span>
        <span class="status-pill ${STATUS[inv.status]?.cls || ''}">${STATUS[inv.status]?.label || inv.status}</span>
        <span class="ilr-amount">${fmt(parseFloat(inv.total))}</span>
        <span class="ilr-arrow">→</span>
      </div>
    `).join('')}
  `;
}

// ── AVIS ──────────────────────────────────────────────────────
let selectedRating = 0;
const ratingLabels = ['', 'Mauvais', 'Passable', 'Bien', 'Très bien', 'Excellent !'];

function openReviewModal() {
  // Reset state
  selectedRating = 0;
  const commentEl = document.getElementById('review-comment') as HTMLTextAreaElement;
  if (commentEl) commentEl.value = '';
  const charCount = document.getElementById('char-count');
  if (charCount) charCount.textContent = '0';
  const errEl = document.getElementById('review-err');
  if (errEl) errEl.textContent = '';
  const labelEl = document.getElementById('rating-label');
  if (labelEl) labelEl.textContent = 'Choisissez une note';
  document.querySelectorAll('.star').forEach(s => s.classList.remove('star-on'));
  // Show form, hide success
  ['rm-head','rm-rating-block','rm-field','rm-foot'].forEach(id => {
    const el = document.getElementById(id); if (el) el.style.display = '';
  });
  const successEl = document.getElementById('review-success');
  if (successEl) successEl.style.display = 'none';
  const modal = document.getElementById('review-modal');
  if (modal) modal.style.display = 'flex';
}

document.getElementById('open-review-modal')?.addEventListener('click', openReviewModal);
document.getElementById('close-review-modal')?.addEventListener('click', () => { document.getElementById('review-modal')!.style.display = 'none'; });
document.getElementById('cancel-review')?.addEventListener('click', () => { document.getElementById('review-modal')!.style.display = 'none'; });
document.getElementById('review-modal')?.addEventListener('click', e => { if (e.target === document.getElementById('review-modal')) document.getElementById('review-modal')!.style.display = 'none'; });

document.querySelectorAll('.star').forEach(star => {
  const val = parseInt((star as HTMLElement).dataset.val!);
  star.addEventListener('mouseenter', () => {
    document.querySelectorAll('.star').forEach((s, i) => s.classList.toggle('star-on', i < val));
  });
  star.addEventListener('mouseleave', () => {
    document.querySelectorAll('.star').forEach((s, i) => s.classList.toggle('star-on', i < selectedRating));
  });
  star.addEventListener('click', () => {
    selectedRating = val;
    document.querySelectorAll('.star').forEach((s, i) => s.classList.toggle('star-on', i < val));
    const labelEl = document.getElementById('rating-label');
    if (labelEl) labelEl.textContent = ratingLabels[val];
  });
});

document.getElementById('review-comment')?.addEventListener('input', function() {
  const charCount = document.getElementById('char-count');
  if (charCount) charCount.textContent = (this as HTMLTextAreaElement).value.length.toString();
});

document.getElementById('submit-review')?.addEventListener('click', async () => {
  const comment = ((document.getElementById('review-comment') as HTMLTextAreaElement).value || '').trim();
  const errEl = document.getElementById('review-err')!;
  errEl.textContent = '';
  if (!selectedRating) { errEl.textContent = 'Veuillez choisir une note.'; return; }
  if (comment.length < 10) { errEl.textContent = 'Le commentaire doit faire au moins 10 caractères.'; return; }
  const btn = document.getElementById('submit-review') as HTMLButtonElement;
  btn.disabled = true; btn.textContent = 'Envoi...';
  const client = (window as any)._client;
  const displayName = client.name + (client.company ? ` — ${client.company}` : '');
  const { error } = await sb.from('nova_reviews').insert({
    client_id: client.id,
    client_name: displayName,
    rating: selectedRating,
    comment,
    approved: false,
  });
  if (error) {
    errEl.textContent = 'Erreur lors de l\'envoi. Veuillez réessayer.';
    btn.disabled = false;
    btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Publier mon avis';
  } else {
    ['rm-head','rm-rating-block','rm-field','rm-foot'].forEach(id => {
      const el = document.getElementById(id); if (el) el.style.display = 'none';
    });
    const successEl = document.getElementById('review-success');
    if (successEl) successEl.style.display = 'flex';
    const banner = document.getElementById('review-banner');
    if (banner) banner.style.display = 'none';
    setTimeout(() => { const m = document.getElementById('review-modal'); if (m) m.style.display = 'none'; }, 3500);
  }
});

(window as any).viewInvoice = (id: string) => {
  const invs = (window as any)._invoices as any[];
  const inv  = invs.find((i:any) => i.id === id); if (!inv) return;
  const client = (window as any)._client;

  document.getElementById('portal-dashboard')!.style.display = 'none';
  document.getElementById('invoice-detail')!.style.display   = 'block';

  const set = (elId: string, val: string) => { const e = document.getElementById(elId); if (e) e.textContent = val; };
  set('inv-doc-number',    inv.invoice_number);
  set('inv-title-display', inv.title);
  set('inv-doc-date',      fmtDate(inv.created_at));
  set('inv-doc-due',       fmtDate(inv.due_date));
  set('inv-client-name',   client.name);
  set('inv-client-company',client.company || '');
  set('inv-client-email',  client.email);
  set('inv-t-sub',         fmt(parseFloat(inv.subtotal)));
  set('inv-t-total',       fmt(parseFloat(inv.total)));

  const statusEl = document.getElementById('inv-doc-status');
  if (statusEl) statusEl.innerHTML = `<span class="status-pill ${STATUS[inv.status]?.cls || ''}">${STATUS[inv.status]?.label || inv.status}</span>`;

  const tpsRow = document.getElementById('inv-t-tps-row');
  const tvqRow = document.getElementById('inv-t-tvq-row');
  if (inv.tps_amount && parseFloat(inv.tps_amount) > 0) { set('inv-t-tps', fmt(parseFloat(inv.tps_amount))); if (tpsRow) tpsRow.style.display = 'flex'; }
  else { if (tpsRow) tpsRow.style.display = 'none'; }
  if (inv.tvq_amount && parseFloat(inv.tvq_amount) > 0) { set('inv-t-tvq', fmt(parseFloat(inv.tvq_amount))); if (tvqRow) tvqRow.style.display = 'flex'; }
  else { if (tvqRow) tvqRow.style.display = 'none'; }

  const tbody = document.getElementById('inv-items-body');
  if (tbody && Array.isArray(inv.items)) {
    tbody.innerHTML = inv.items.map((it: any) => `
      <tr>
        <td>${it.desc}</td>
        <td class="td-center">${it.qty}</td>
        <td class="td-right">${fmt(parseFloat(it.price))}</td>
        <td class="td-right">${fmt(it.qty * parseFloat(it.price))}</td>
      </tr>
    `).join('');
  }

  const nb = document.getElementById('inv-notes-block');
  const nt = document.getElementById('inv-notes-text');
  if (inv.notes) { if (nt) nt.textContent = inv.notes; if (nb) nb.style.display = 'block'; }
  else { if (nb) nb.style.display = 'none'; }
};
</script>

