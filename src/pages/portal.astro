---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Portail client — Nova Studio">
<main>

  <!-- LOGIN -->
  <div id="login-screen" class="portal-center">
    <div class="portal-card">
      <div class="portal-logo">
        <svg width="44" height="44" viewBox="0 0 40 40" fill="none">
          <defs><linearGradient id="pg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4F6AFF"/><stop offset="100%" stop-color="#9B50FF"/></linearGradient></defs>
          <path d="M6 34V6l22 28V6" stroke="url(#pg)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M18 6l16 28" stroke="#0F1322" stroke-width="5" stroke-linecap="round"/>
          <path d="M18 6l16 28" stroke="url(#pg)" stroke-width="3" stroke-linecap="round"/>
          <circle cx="32" cy="8" r="2.5" fill="#9B50FF"/>
        </svg>
        <div><span class="logo-nova">NOVA</span><span class="logo-studio">STUDIO</span></div>
      </div>
      <h2>Portail client</h2>
      <p class="portal-login-sub">Accédez à vos factures et documents</p>
      <form id="login-form">
        <div class="pfield">
          <label>Adresse courriel</label>
          <input type="email" id="login-email" placeholder="vous@exemple.com" required autocomplete="email" />
        </div>
        <div class="pfield">
          <label>Mot de passe</label>
          <input type="password" id="login-pwd" placeholder="••••••••" required autocomplete="current-password" />
        </div>
        <p id="login-err" class="login-err"></p>
        <button type="submit" class="btn-login" id="login-btn">Se connecter</button>
      </form>
      <a href="/" class="back-site">← Retour au site</a>
    </div>
  </div>

  <!-- DASHBOARD -->
  <div id="portal-app" style="display:none">
    <header class="portal-header">
      <div class="ph-inner">
        <a href="/" class="portal-logo-link">
          <svg width="28" height="28" viewBox="0 0 40 40" fill="none">
            <defs><linearGradient id="pg2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4F6AFF"/><stop offset="100%" stop-color="#9B50FF"/></linearGradient></defs>
            <path d="M6 34V6l22 28V6" stroke="url(#pg2)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18 6l16 28" stroke="#0F1322" stroke-width="5" stroke-linecap="round"/>
            <path d="M18 6l16 28" stroke="url(#pg2)" stroke-width="3" stroke-linecap="round"/>
            <circle cx="32" cy="8" r="2.5" fill="#9B50FF"/>
          </svg>
          <div><span class="logo-nova">NOVA</span><span class="logo-studio">STUDIO</span></div>
        </a>
        <div class="ph-user">
          <span id="ph-welcome">Bonjour</span>
          <button id="portal-logout" class="btn-logout">Déconnexion</button>
        </div>
      </div>
    </header>

    <div class="portal-body">
      <div class="portal-page-head">
        <h1>Mes factures</h1>
        <p id="portal-company" class="portal-company"></p>
      </div>

      <!-- Stats rapides -->
      <div class="portal-stats" id="portal-stats"></div>

      <!-- Liste des factures -->
      <div id="portal-invoices" class="portal-invoices-list"></div>

      <!-- Vue détaillée d'une facture -->
      <div id="invoice-detail" class="invoice-detail" style="display:none">
        <button id="back-to-list" class="back-btn">← Retour à la liste</button>
        <div id="invoice-print-zone" class="invoice-print-zone">

          <div class="inv-doc-header">
            <div class="inv-doc-logo">
              <svg width="36" height="36" viewBox="0 0 40 40" fill="none">
                <defs><linearGradient id="pg3" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4F6AFF"/><stop offset="100%" stop-color="#9B50FF"/></linearGradient></defs>
                <path d="M6 34V6l22 28V6" stroke="url(#pg3)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M18 6l16 28" stroke="#0F1322" stroke-width="5" stroke-linecap="round"/>
                <path d="M18 6l16 28" stroke="url(#pg3)" stroke-width="3" stroke-linecap="round"/>
                <circle cx="32" cy="8" r="2.5" fill="#9B50FF"/>
              </svg>
              <div><span class="logo-nova" style="font-size:1.2rem">NOVA</span><span class="logo-studio" style="font-size:0.65rem">STUDIO</span></div>
            </div>
            <div class="inv-doc-meta">
              <h2 id="inv-doc-title">FACTURE</h2>
              <p id="inv-doc-number" class="inv-doc-num"></p>
            </div>
          </div>

          <div class="inv-doc-parties">
            <div>
              <p class="inv-party-label">ÉMETTEUR</p>
              <p class="inv-party-name">Nova Studio</p>
              <p class="inv-party-info">contact@nova-studio.ca</p>
              <p class="inv-party-info">Québec, Canada</p>
            </div>
            <div class="inv-party-right">
              <p class="inv-party-label">FACTURER À</p>
              <p class="inv-party-name" id="inv-client-name"></p>
              <p class="inv-party-info" id="inv-client-company"></p>
              <p class="inv-party-info" id="inv-client-email"></p>
            </div>
            <div>
              <p class="inv-party-label">DATES</p>
              <div class="inv-dates">
                <div><span>Émise</span><strong id="inv-doc-date"></strong></div>
                <div><span>Échéance</span><strong id="inv-doc-due"></strong></div>
              </div>
              <div class="inv-status-display" id="inv-status-display"></div>
            </div>
          </div>

          <table class="inv-items-table">
            <thead>
              <tr><th>Description</th><th>Qté</th><th>Prix unit.</th><th>Total</th></tr>
            </thead>
            <tbody id="inv-items-body"></tbody>
          </table>

          <div class="inv-totals-block">
            <div class="itb-row"><span>Sous-total</span><span id="inv-t-sub"></span></div>
            <div class="itb-row" id="inv-t-tps-row"><span>TPS (5%)</span><span id="inv-t-tps"></span></div>
            <div class="itb-row" id="inv-t-tvq-row"><span>TVQ (9,975%)</span><span id="inv-t-tvq"></span></div>
            <div class="itb-row itb-total"><span>TOTAL</span><span id="inv-t-total"></span></div>
          </div>

          <div id="inv-notes-block" class="inv-notes-block" style="display:none">
            <p class="inv-notes-label">Notes</p>
            <p id="inv-notes-text"></p>
          </div>

          <div class="inv-footer-text">Merci de votre confiance — Nova Studio</div>
        </div>
        <button id="print-btn" class="btn-print" onclick="window.print()">🖨️ Imprimer / PDF</button>
      </div>

    </div>
  </div>

</main>
</Layout>

<script>
import { createClient } from '@supabase/supabase-js';
const sb = createClient(
  'https://gnpjilwdehxsafdqdtak.supabase.co',
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImducGppbHdkZWh4c2FmZHFkdGFrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk5Nzk3NjIsImV4cCI6MjA5NTU1NTc2Mn0.iFYR9r5ZZsKcc9n2N8jPtFTLs0QDTIqR3KMCMhCdSdA'
);

const fmt    = (n: number) => n.toLocaleString('fr-CA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' $';
const fmtDate = (d: string) => d ? new Date(d).toLocaleDateString('fr-CA', { day: 'numeric', month: 'long', year: 'numeric' }) : 'N/A';

const STATUS: Record<string,{label:string;cls:string}> = {
  pending:   { label: 'En attente',  cls: 'status-pending' },
  paid:      { label: 'Payée',       cls: 'status-paid' },
  overdue:   { label: 'En retard',   cls: 'status-overdue' },
  cancelled: { label: 'Annulée',     cls: 'status-cancelled' },
};

// Check session
const saved = localStorage.getItem('nova-portal-client');
if (saved) {
  const c = JSON.parse(saved);
  showApp(c);
}

// Login
document.getElementById('login-form')?.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = document.getElementById('login-btn') as HTMLButtonElement;
  const err = document.getElementById('login-err');
  btn.disabled = true; btn.textContent = 'Connexion...';
  if (err) err.textContent = '';

  const email = (document.getElementById('login-email') as HTMLInputElement).value.trim().toLowerCase();
  const pwd   = (document.getElementById('login-pwd') as HTMLInputElement).value;

  try {
    const res  = await fetch('/api/nova-auth', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password: pwd }) });
    const data = await res.json();
    if (!res.ok) { if (err) err.textContent = data.error || 'Identifiants invalides'; }
    else {
      localStorage.setItem('nova-portal-client', JSON.stringify(data));
      showApp(data);
    }
  } catch { if (err) err.textContent = 'Erreur de connexion'; }
  btn.disabled = false; btn.textContent = 'Se connecter';
});

document.getElementById('portal-logout')?.addEventListener('click', () => {
  localStorage.removeItem('nova-portal-client');
  location.reload();
});

document.getElementById('back-to-list')?.addEventListener('click', () => {
  document.getElementById('invoice-detail')!.style.display = 'none';
  document.getElementById('portal-invoices')!.style.display = 'flex';
});

async function showApp(client: any) {
  document.getElementById('login-screen')!.style.display = 'none';
  document.getElementById('portal-app')!.style.display   = 'block';
  const welEl = document.getElementById('ph-welcome');
  if (welEl) welEl.textContent = `Bonjour, ${client.name}`;
  const compEl = document.getElementById('portal-company');
  if (compEl && client.company) compEl.textContent = client.company;

  const { data: invoices } = await sb.from('nova_invoices').select('*').eq('client_id', client.id).order('created_at', { ascending: false });
  const invs = invoices || [];

  // Stats
  const pending = invs.filter(i => i.status === 'pending').reduce((s, i) => s + parseFloat(i.total), 0);
  const paid    = invs.filter(i => i.status === 'paid').reduce((s, i) => s + parseFloat(i.total), 0);
  const statsEl = document.getElementById('portal-stats');
  if (statsEl) statsEl.innerHTML = `
    <div class="ps-box"><span class="ps-n">${invs.length}</span><span class="ps-l">Factures</span></div>
    <div class="ps-box ps-warn"><span class="ps-n">${fmt(pending)}</span><span class="ps-l">En attente</span></div>
    <div class="ps-box ps-ok"><span class="ps-n">${fmt(paid)}</span><span class="ps-l">Payé</span></div>
  `;

  // Invoices list
  const listEl = document.getElementById('portal-invoices');
  if (listEl) {
    if (!invs.length) { listEl.innerHTML = '<div class="empty-inv">Aucune facture pour l\'instant.</div>'; }
    else {
      listEl.style.display = 'flex';
      listEl.innerHTML = invs.map(inv => `
        <div class="portal-inv-card" data-id="${inv.id}">
          <div class="pic-left">
            <p class="pic-num">${inv.invoice_number}</p>
            <p class="pic-date">${fmtDate(inv.created_at)}</p>
          </div>
          <div class="pic-mid">
            <p class="pic-title">${inv.title}</p>
            ${inv.due_date ? `<p class="pic-due">Échéance : ${fmtDate(inv.due_date)}</p>` : ''}
          </div>
          <span class="status-chip ${STATUS[inv.status]?.cls || ''}">${STATUS[inv.status]?.label || inv.status}</span>
          <p class="pic-total">${fmt(parseFloat(inv.total))}</p>
          <button class="btn-view" onclick="viewInvoice('${inv.id}', ${JSON.stringify(client).replace(/"/g, '&quot;')})">Voir →</button>
        </div>
      `).join('');
    }
  }

  (window as any)._invoices = invs;
  (window as any)._client   = client;
}

(window as any).viewInvoice = (id: string, client: any) => {
  const invs  = (window as any)._invoices as any[];
  const inv   = invs.find(i => i.id === id);
  if (!inv) return;

  document.getElementById('portal-invoices')!.style.display = 'none';
  document.getElementById('invoice-detail')!.style.display  = 'block';

  const set = (elId: string, val: string) => { const e = document.getElementById(elId); if (e) e.textContent = val; };
  set('inv-doc-number',     inv.invoice_number);
  set('inv-doc-date',       fmtDate(inv.created_at));
  set('inv-doc-due',        fmtDate(inv.due_date));
  set('inv-client-name',    client.name);
  set('inv-client-company', client.company || '');
  set('inv-client-email',   client.email);
  set('inv-t-sub',          fmt(parseFloat(inv.subtotal)));
  set('inv-t-total',        fmt(parseFloat(inv.total)));

  // Taxes
  const tpsRow = document.getElementById('inv-t-tps-row');
  const tvqRow = document.getElementById('inv-t-tvq-row');
  if (inv.tps_amount !== undefined && parseFloat(inv.tps_amount) > 0) {
    set('inv-t-tps', fmt(parseFloat(inv.tps_amount)));
    if (tpsRow) tpsRow.style.display = 'flex';
  } else { if (tpsRow) tpsRow.style.display = 'none'; }
  if (inv.tvq_amount !== undefined && parseFloat(inv.tvq_amount) > 0) {
    set('inv-t-tvq', fmt(parseFloat(inv.tvq_amount)));
    if (tvqRow) tvqRow.style.display = 'flex';
  } else { if (tvqRow) tvqRow.style.display = 'none'; }

  // Status badge
  const statusEl = document.getElementById('inv-status-display');
  if (statusEl) statusEl.innerHTML = `<span class="status-chip ${STATUS[inv.status]?.cls || ''}">${STATUS[inv.status]?.label || inv.status}</span>`;

  // Items
  const tbody = document.getElementById('inv-items-body');
  if (tbody && Array.isArray(inv.items)) {
    tbody.innerHTML = inv.items.map((it: any) => `
      <tr>
        <td>${it.desc}</td>
        <td class="tc">${it.qty}</td>
        <td class="tr">${fmt(parseFloat(it.price))}</td>
        <td class="tr">${fmt(it.qty * parseFloat(it.price))}</td>
      </tr>
    `).join('');
  }

  // Notes
  const notesBlock = document.getElementById('inv-notes-block');
  const notesText  = document.getElementById('inv-notes-text');
  if (inv.notes) {
    if (notesText) notesText.textContent = inv.notes;
    if (notesBlock) notesBlock.style.display = 'block';
  } else { if (notesBlock) notesBlock.style.display = 'none'; }
};
</script>

<style>
  main { min-height: 100vh; background: var(--bg); }

  /* ── Login ── */
  .portal-center { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; }
  .portal-card { background: #fff; border: 1px solid var(--border); border-radius: 24px; padding: 3rem 2.5rem; width: 100%; max-width: 420px; box-shadow: 0 8px 40px rgba(79,106,255,0.1); display: flex; flex-direction: column; gap: 1rem; }
  .portal-logo { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; }
  .portal-logo div { display: flex; flex-direction: column; }
  .logo-nova   { font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem; font-weight: 700; color: var(--navy); letter-spacing: 0.1em; line-height: 1; }
  .logo-studio { font-size: 0.58rem; font-weight: 500; color: var(--blue); letter-spacing: 0.18em; }
  .portal-card h2 { font-size: 1.35rem; }
  .portal-login-sub { font-size: 0.85rem; color: var(--text-2); }
  #login-form { display: flex; flex-direction: column; gap: 1rem; margin-top: 0.5rem; }
  .pfield { display: flex; flex-direction: column; gap: 0.4rem; }
  .pfield label { font-size: 0.8rem; font-weight: 600; }
  .pfield input { background: var(--bg); border: 1.5px solid var(--border); border-radius: 10px; padding: 0.72rem 1rem; font-size: 0.9rem; font-family: 'Inter', sans-serif; outline: none; }
  .pfield input:focus { border-color: var(--blue); }
  .login-err { font-size: 0.8rem; color: var(--danger); min-height: 1rem; }
  .btn-login { background: var(--gradient); color: #fff; border: none; padding: 0.85rem; border-radius: 12px; font-size: 0.9rem; font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif; transition: opacity 0.2s; }
  .btn-login:hover { opacity: 0.88; }
  .btn-login:disabled { opacity: 0.6; }
  .back-site { font-size: 0.82rem; color: var(--text-2); text-align: center; margin-top: 0.5rem; transition: color 0.2s; }
  .back-site:hover { color: var(--blue); }

  /* ── Portal app ── */
  .portal-header { background: #fff; border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 50; }
  .ph-inner { max-width: 1000px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; height: 64px; }
  .portal-logo-link { display: flex; align-items: center; gap: 0.5rem; }
  .ph-user { display: flex; align-items: center; gap: 1rem; }
  #ph-welcome { font-size: 0.875rem; font-weight: 500; color: var(--text-2); }
  .btn-logout { background: none; border: 1px solid var(--border); color: var(--text-2); padding: 0.4rem 0.9rem; border-radius: 8px; font-size: 0.78rem; cursor: pointer; font-family: 'Inter', sans-serif; }

  .portal-body { max-width: 1000px; margin: 0 auto; padding: 2.5rem 2rem 4rem; }
  .portal-page-head { margin-bottom: 1.5rem; }
  .portal-page-head h1 { font-size: 1.6rem; }
  .portal-company { font-size: 0.875rem; color: var(--text-2); margin-top: 0.25rem; }

  /* Stats */
  .portal-stats { display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .ps-box { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 0.2rem; flex: 1; min-width: 160px; }
  .ps-n { font-family: 'Space Grotesk', sans-serif; font-size: 1.4rem; font-weight: 700; color: var(--navy); }
  .ps-l { font-size: 0.75rem; color: var(--text-2); }
  .ps-warn .ps-n { color: #d97706; }
  .ps-ok  .ps-n { color: var(--success); }

  /* Invoice cards */
  .portal-invoices-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .portal-inv-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 1.5rem; transition: border-color 0.2s; }
  .portal-inv-card:hover { border-color: rgba(79,106,255,0.3); }
  .pic-left { flex-shrink: 0; }
  .pic-num  { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 0.9rem; }
  .pic-date { font-size: 0.72rem; color: var(--text-2); margin-top: 2px; }
  .pic-mid  { flex: 1; }
  .pic-title { font-weight: 600; font-size: 0.9rem; }
  .pic-due  { font-size: 0.75rem; color: var(--text-2); margin-top: 2px; }
  .pic-total { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1rem; white-space: nowrap; }
  .btn-view { background: var(--gradient); color: #fff; border: none; padding: 0.5rem 1.1rem; border-radius: 8px; font-size: 0.82rem; font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif; white-space: nowrap; }

  /* Status chips */
  .status-chip { font-size: 0.72rem; font-weight: 700; padding: 0.25rem 0.7rem; border-radius: 999px; }
  .status-pending   { background: rgba(245,158,11,0.1);  color: #d97706; }
  .status-paid      { background: rgba(16,185,129,0.1);  color: #059669; }
  .status-overdue   { background: rgba(239,68,68,0.1);   color: #dc2626; }
  .status-cancelled { background: rgba(107,114,128,0.1); color: #6b7280; }

  /* Invoice detail */
  .invoice-detail { max-width: 820px; margin: 0 auto; }
  .back-btn { background: none; border: none; color: var(--blue); font-size: 0.875rem; font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif; padding: 0; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.25rem; }
  .invoice-print-zone { background: #fff; border: 1px solid var(--border); border-radius: 20px; padding: 3rem; }

  .inv-doc-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
  .inv-doc-logo { display: flex; align-items: center; gap: 0.5rem; }
  .inv-doc-logo div { display: flex; flex-direction: column; }
  .inv-doc-meta { text-align: right; }
  .inv-doc-meta h2 { font-size: 1.6rem; letter-spacing: 0.08em; background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .inv-doc-num { font-size: 0.875rem; color: var(--text-2); margin-top: 0.25rem; }

  .inv-doc-parties { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2rem; margin-bottom: 2.5rem; }
  .inv-party-label { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue); margin-bottom: 0.5rem; }
  .inv-party-name  { font-weight: 700; font-size: 0.95rem; margin-bottom: 0.25rem; }
  .inv-party-info  { font-size: 0.82rem; color: var(--text-2); }
  .inv-dates { display: flex; flex-direction: column; gap: 0.4rem; }
  .inv-dates div { display: flex; gap: 0.5rem; font-size: 0.82rem; }
  .inv-dates span { color: var(--text-2); }
  .inv-dates strong { color: var(--text); }
  .inv-status-display { margin-top: 0.75rem; }

  .inv-items-table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
  .inv-items-table thead th { padding: 0.75rem 1rem; text-align: left; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-2); background: var(--bg); border-bottom: 1px solid var(--border); }
  .inv-items-table thead th:last-child { text-align: right; }
  .inv-items-table tbody td { padding: 0.85rem 1rem; font-size: 0.875rem; border-bottom: 1px solid var(--border); }
  .tc { text-align: center; }
  .tr { text-align: right; }

  .inv-totals-block { max-width: 320px; margin-left: auto; display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; }
  .itb-row { display: flex; justify-content: space-between; font-size: 0.875rem; color: var(--text-2); }
