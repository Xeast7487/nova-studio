const STATUS_LABELS: Record<string,string> = { pending:'En attente', paid:'Payée', overdue:'En retard', cancelled:'Annulée' };

async function loadInvoices() {
  const { data } = await sb.from('nova_invoices').select('*, nova_clients(name, company)').order('created_at', { ascending: false });
  const el = document.getElementById('invoices-list'); if (!el) return;
  if (!data?.length) { el.innerHTML = '<div class="empty-state"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><p>Aucune facture</p><small>Créez votre première facture</small></div>'; return; }
  el.innerHTML = data.map(inv => `
    <div class="data-row">
      <div class="dr-inv-num">
        <p class="dr-name">${inv.invoice_number}</p>
        <p class="dr-meta">${new Date(inv.created_at).toLocaleDateString('fr-CA')}</p>
      </div>
      <div class="dr-main">
        <p class="dr-name">${inv.title}</p>
        <p class="dr-meta">${(inv as any).nova_clients?.name || ''}${(inv as any).nova_clients?.company ? ` · ${(inv as any).nova_clients.company}` : ''}</p>
      </div>
      <span class="status-pill status-${inv.status}">${STATUS_LABELS[inv.status]}</span>
      <p class="dr-amount">${fmt(parseFloat(inv.total))}</p>
      <div class="dr-actions">
        <button class="action-btn action-default" onclick="editInvoice('${inv.id}')">Modifier</button>
        <button class="action-btn ${inv.status === 'paid' ? 'action-ghost' : 'action-success'}" onclick="markPaid('${inv.id}','${inv.status}')">${inv.status === 'paid' ? 'Annuler paiement' : '✓ Marquer payée'}</button>
        <button class="action-btn action-danger" onclick="deleteInvoice('${inv.id}')">Supprimer</button>
      </div>
    </div>
  `).join('');
  await loadStats();
}

let invItems: {desc:string;qty:number;price:number}[] = [];

document.getElementById('open-invoice-modal')?.addEventListener('click', () => { resetInvoiceForm(); openModal('invoice-modal'); loadClients(); });
document.getElementById('close-invoice-modal')?.addEventListener('click', () => closeModal('invoice-modal'));
document.getElementById('cancel-invoice')?.addEventListener('click', () => closeModal('invoice-modal'));
document.getElementById('add-item-btn')?.addEventListener('click', () => { invItems.push({desc:'',qty:1,price:0}); renderInvItems(); });

function renderInvItems() {
  const el = document.getElementById('inv-items'); if (!el) return;
  el.innerHTML = invItems.map((item, i) => `
    <div class="item-row">
      <input type="text" placeholder="Description du service ou produit" value="${item.desc}" onchange="updateItem(${i},'desc',this.value)" />
      <input type="number" min="1" value="${item.qty}" onchange="updateItem(${i},'qty',+this.value)" />
      <input type="number" min="0" step="0.01" value="${item.price}" onchange="updateItem(${i},'price',+this.value)" placeholder="0.00" />
      <span class="item-line-total">${fmt(item.qty * item.price)}</span>
      <button type="button" class="item-remove" onclick="removeItem(${i})">×</button>
    </div>
  `).join('');
  calcTotals();
}

(window as any).updateItem = (i: number, key: string, val: any) => { invItems[i][key as keyof typeof invItems[0]] = val; renderInvItems(); };
(window as any).removeItem = (i: number) => { invItems.splice(i,1); renderInvItems(); };

function calcTotals() {
  const sub  = invItems.reduce((s, it) => s + it.qty * it.price, 0);
  const applyTps = (document.getElementById('apply-tps') as HTMLInputElement)?.checked;
  const applyTvq = (document.getElementById('apply-tvq') as HTMLInputElement)?.checked;
  const tps = applyTps ? sub * 0.05 : 0;
  const tvq = applyTvq ? sub * 0.09975 : 0;
  const total = sub + tps + tvq;
  const set = (id: string, v: string) => { const e = document.getElementById(id); if (e) e.textContent = v; };
  set('disp-subtotal', fmt(sub)); set('disp-tps', fmt(tps)); set('disp-tvq', fmt(tvq)); set('disp-total', fmt(total));
  const rt = document.getElementById('row-tps'); const rv = document.getElementById('row-tvq');
  if (rt) rt.style.opacity = applyTps ? '1' : '0.35';
  if (rv) rv.style.opacity = applyTvq ? '1' : '0.35';
  return { sub, tps, tvq, total, applyTps, applyTvq };
}
document.getElementById('apply-tps')?.addEventListener('change', calcTotals);
document.getElementById('apply-tvq')?.addEventListener('change', calcTotals);

document.getElementById('invoice-form')?.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = document.getElementById('save-invoice-btn') as HTMLButtonElement;
  btn.disabled = true; btn.textContent = 'Enregistrement...';
  const editId = (document.getElementById('inv-edit-id') as HTMLInputElement).value;
  const { sub, tps, tvq, total, applyTps, applyTvq } = calcTotals();
  const due = (document.getElementById('inv-due') as HTMLInputElement).value;
  const payload = {
    client_id:      (document.getElementById('inv-client') as HTMLSelectElement).value,
    invoice_number: (document.getElementById('inv-number') as HTMLInputElement).value.trim(),
    title:          (document.getElementById('inv-title')  as HTMLInputElement).value.trim(),
    items:          invItems,
    subtotal:       Math.round(sub   * 100) / 100,
    tax_rate:       applyTps ? 5 : 0,
    tax:            Math.round((tps + tvq) * 100) / 100,
    total:          Math.round(total * 100) / 100,
    apply_tps:      applyTps,
    apply_tvq:      applyTvq,
    tps_amount:     Math.round(tps * 100) / 100,
    tvq_amount:     Math.round(tvq * 100) / 100,
    status:         (document.getElementById('inv-status') as HTMLSelectElement).value,
    due_date:       due || null,
    notes:          (document.getElementById('inv-notes') as HTMLTextAreaElement).value.trim(),
  };
  try {
    if (editId) await sb.from('nova_invoices').update(payload).eq('id', editId);
    else        await sb.from('nova_invoices').insert(payload);
    closeModal('invoice-modal'); await loadInvoices();
  } catch (err: any) { alert('Erreur : ' + err.message); }
  btn.disabled = false; btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Enregistrer la facture';
});

(window as any).markPaid = async (id: string, current: string) => {
  await sb.from('nova_invoices').update({ status: current === 'paid' ? 'pending' : 'paid' }).eq('id', id); await loadInvoices();
};
(window as any).deleteInvoice = async (id: string) => {
  if (!confirm('Supprimer cette facture ?')) return;
  await sb.from('nova_invoices').delete().eq('id', id); await loadInvoices();
};
(window as any).editInvoice = async (id: string) => {
  const { data: inv } = await sb.from('nova_invoices').select('*').eq('id', id).single(); if (!inv) return;
  (document.getElementById('inv-edit-id') as HTMLInputElement).value = inv.id;
  (document.getElementById('inv-client')  as HTMLSelectElement).value = inv.client_id;
  (document.getElementById('inv-number')  as HTMLInputElement).value  = inv.invoice_number;
  (document.getElementById('inv-title')   as HTMLInputElement).value  = inv.title;
  (document.getElementById('inv-status')  as HTMLSelectElement).value = inv.status;
  (document.getElementById('inv-due')     as HTMLInputElement).value  = inv.due_date || '';
  (document.getElementById('inv-notes')   as HTMLTextAreaElement).value = inv.notes || '';
  (document.getElementById('apply-tps')   as HTMLInputElement).checked = inv.apply_tps !== false;
  (document.getElementById('apply-tvq')   as HTMLInputElement).checked = inv.apply_tvq !== false;
  invItems = Array.isArray(inv.items) ? inv.items : [];
  renderInvItems();
  (document.getElementById('invoice-modal-title') as HTMLElement).textContent = 'Modifier la facture';
  openModal('invoice-modal');
};

function resetInvoiceForm() {
  (document.getElementById('inv-edit-id') as HTMLInputElement).value = '';
  (document.getElementById('invoice-form') as HTMLFormElement).reset();
  invItems = [{ desc: '', qty: 1, price: 0 }]; renderInvItems();
  (document.getElementById('invoice-modal-title') as HTMLElement).textContent = 'Nouvelle facture';
  const now = new Date(); const n = Math.floor(Math.random() * 900) + 100;
  (document.getElementById('inv-number') as HTMLInputElement).value = `NOVA-${now.getFullYear()}${String(now.getMonth()+1).padStart(2,'0')}-${n}`;
  const due = new Date(); due.setDate(due.getDate() + 30);
  (document.getElementById('inv-due') as HTMLInputElement).value = due.toISOString().split('T')[0];
  (document.getElementById('apply-tps') as HTMLInputElement).checked = true;
  (document.getElementById('apply-tvq') as HTMLInputElement).checked = true;
  calcTotals();
}

function openModal(id: string)  { const m = document.getElementById(id); if (m) m.style.display = 'flex'; }
function closeModal(id: string) { const m = document.getElementById(id); if (m) m.style.display = 'none'; }
document.querySelectorAll('.modal-overlay').forEach(m => m.addEventListener('click', e => { if (e.target === m) (m as HTMLElement).style.display = 'none'; }));

// ── AVIS ──────────────────────────────────────────────────────
const STAR_FILLED = '★';
const starStr = (n: number) => STAR_FILLED.repeat(n) + '☆'.repeat(5 - n);

async function loadReviews() {
  const { data } = await sb.from('nova_reviews').select('*').order('created_at', { ascending: false });
  const all = data || [];
  const pending  = all.filter((r: any) => !r.approved);
  const approved = all.filter((r: any) =>  r.approved);

  const pendingList  = document.getElementById('reviews-pending-list');
  const approvedList = document.getElementById('reviews-approved-list');

  const emptyPending = '<div class="empty-state" style="padding:2rem"><p style="font-weight:600;font-size:.9rem">Aucun avis en attente</p></div>';
  const emptyApproved = '<div class="empty-state" style="padding:2rem"><p style="font-weight:600;font-size:.9rem">Aucun avis publié</p></div>';

  if (pendingList) pendingList.innerHTML = pending.length ? pending.map((r: any) => `
    <div class="data-row review-row">
      <div class="dr-avatar rv-avatar">${r.client_name.charAt(0).toUpperCase()}</div>
      <div class="dr-main">
        <p class="dr-name">${r.client_name}</p>
        <p class="rv-stars">${starStr(r.rating)}</p>
        <p class="rv-comment">"${r.comment}"</p>
        <p class="dr-meta">${new Date(r.created_at).toLocaleDateString('fr-CA', { day:'numeric', month:'long', year:'numeric' })}</p>
      </div>
      <div class="dr-actions">
        <button class="action-btn action-success" onclick="approveReview('${r.id}')">✓ Approuver</button>
        <button class="action-btn action-danger"  onclick="deleteReview('${r.id}')">Supprimer</button>
      </div>
    </div>
  `).join('') : emptyPending;

  if (approvedList) approvedList.innerHTML = approved.length ? approved.map((r: any) => `
    <div class="data-row review-row">
      <div class="dr-avatar rv-avatar rv-approved">${r.client_name.charAt(0).toUpperCase()}</div>
      <div class="dr-main">
        <p class="dr-name">${r.client_name}</p>
        <p class="rv-stars">${starStr(r.rating)}</p>
        <p class="rv-comment">"${r.comment}"</p>
        <p class="dr-meta">${new Date(r.created_at).toLocaleDateString('fr-CA', { day:'numeric', month:'long', year:'numeric' })}</p>
      </div>
      <div class="dr-actions">
        <button class="action-btn action-ghost"  onclick="unapproveReview('${r.id}')">Dépublier</button>
        <button class="action-btn action-danger" onclick="deleteReview('${r.id}')">Supprimer</button>
      </div>
    </div>
  `).join('') : emptyApproved;
}

(window as any).approveReview = async (id: string) => {
  await sb.from('nova_reviews').update({ approved: true }).eq('id', id); loadReviews();
};
(window as any).unapproveReview = async (id: string) => {
  await sb.from('nova_reviews').update({ approved: false }).eq('id', id); loadReviews();
};
(window as any).deleteReview = async (id: string) => {
  if (!confirm('Supprimer cet avis définitivement ?')) return;
  await sb.from('nova_reviews').delete().eq('id', id); loadReviews();
};

// ── IMPRESSIONS 3D ────────────────────────────────────────────
const PRINT_STATUS: Record<string,string> = {
  todo:        '📋 À commencer',
  in_progress: '🔄 En cours',
  done:        '✅ Terminé',
  paid:        '💰 Payé',
};
const PRINT_STATUS_CSS: Record<string,string> = {
  todo:        'status-pending',
  in_progress: 'status-print-progress',
  done:        'status-print-done',
  paid:        'status-paid',
};

document.getElementById('open-print-modal')?.addEventListener('click', () => { resetPrintForm(); openModal('print-modal'); });
document.getElementById('close-print-modal')?.addEventListener('click', () => closeModal('print-modal'));
document.getElementById('cancel-print')?.addEventListener('click', () => closeModal('print-modal'));

