---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Admin — Nova Studio">

<!-- LOCK SCREEN -->
<div id="lock-screen" class="lock-wrap">
  <div class="lock-left">
    <div class="lock-brand">
      <svg width="48" height="48" viewBox="0 0 40 40" fill="none">
        <defs><linearGradient id="lg0" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4F6AFF"/><stop offset="100%" stop-color="#9B50FF"/></linearGradient></defs>
        <path d="M6 34V6l22 28V6" stroke="url(#lg0)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M18 6l16 28" stroke="rgba(255,255,255,0.15)" stroke-width="5" stroke-linecap="round"/>
        <path d="M18 6l16 28" stroke="url(#lg0)" stroke-width="3" stroke-linecap="round"/>
        <circle cx="32" cy="8" r="2.5" fill="#9B50FF"/>
      </svg>
      <div class="lock-brand-text">
        <span class="lb-nova">NOVA</span>
        <span class="lb-studio">STUDIO</span>
      </div>
    </div>
    <p class="lock-tagline">Panneau d'administration</p>
    <div class="lock-features">
      <div class="lf-item"><span class="lf-dot"></span>Gestion des clients</div>
      <div class="lf-item"><span class="lf-dot"></span>Facturation TPS/TVQ</div>
      <div class="lf-item"><span class="lf-dot"></span>Portail client sécurisé</div>
    </div>
  </div>
  <div class="lock-right">
    <div class="lock-form-card">
      <div class="lock-form-head">
        <h2>Connexion administrateur</h2>
        <p>Accès réservé à Nova Studio</p>
      </div>
      <div class="lock-field">
        <label>Mot de passe</label>
        <div class="lock-input-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <input type="password" id="pwd" placeholder="••••••••" autofocus />
        </div>
      </div>
      <p id="pwd-err" class="lock-err"></p>
      <button id="pwd-btn" class="lock-btn">
        <span>Accéder au tableau de bord</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
      <a href="/" class="lock-back">← Retour au site</a>
    </div>
  </div>
</div>

<!-- ADMIN APP -->
<div id="admin-app" style="display:none" class="admin-wrap">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <a href="/" class="sidebar-logo">
      <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
        <defs><linearGradient id="lg1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4F6AFF"/><stop offset="100%" stop-color="#9B50FF"/></linearGradient></defs>
        <path d="M6 34V6l22 28V6" stroke="url(#lg1)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M18 6l16 28" stroke="rgba(255,255,255,0.12)" stroke-width="5" stroke-linecap="round"/>
        <path d="M18 6l16 28" stroke="url(#lg1)" stroke-width="3" stroke-linecap="round"/>
        <circle cx="32" cy="8" r="2.5" fill="#9B50FF"/>
      </svg>
      <div><span class="sbl-n">NOVA</span><span class="sbl-s">STUDIO</span></div>
    </a>

    <nav class="sidebar-nav">
      <p class="snav-label">Menu</p>
      <button class="snav-item active" data-tab="clients">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Clients
      </button>
      <button class="snav-item" data-tab="invoices">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        Factures
      </button>
      <button class="snav-item" data-tab="reviews">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Avis clients
      </button>
      <button class="snav-item" data-tab="prints">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        Impressions 3D
      </button>
    </nav>

    <div class="sidebar-foot">
      <a href="/portal" target="_blank" class="sf-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Portail client
      </a>
      <button id="logout-btn" class="sf-logout">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Déconnexion
      </button>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="admin-main">

    <!-- STATS -->
    <div class="stats-bar" id="admin-stats"></div>

    <!-- TAB: CLIENTS -->
    <div id="tab-clients" class="tab-pane">
      <div class="pane-header">
        <div>
          <h1>Clients</h1>
          <p class="pane-sub">Gérez vos clients et leurs accès portail</p>
        </div>
        <button id="open-client-modal" class="btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nouveau client
        </button>
      </div>
      <div id="clients-list" class="data-list"></div>
    </div>

    <!-- TAB: AVIS -->
    <div id="tab-reviews" class="tab-pane" style="display:none">
      <div class="pane-header">
        <div>
          <h1>Avis clients</h1>
          <p class="pane-sub">Modérez les avis laissés par vos clients ayant une facture payée</p>
        </div>
      </div>
      <div id="reviews-pending-section">
        <p class="reviews-section-label">En attente de validation</p>
        <div id="reviews-pending-list" class="data-list"></div>
      </div>
      <div id="reviews-approved-section" style="margin-top:2rem">
        <p class="reviews-section-label">Publiés sur le site</p>
        <div id="reviews-approved-list" class="data-list"></div>
      </div>
    </div>

    <!-- TAB: FACTURES -->
    <div id="tab-invoices" class="tab-pane" style="display:none">
      <div class="pane-header">
        <div>
          <h1>Factures</h1>
          <p class="pane-sub">Créez et gérez les factures de vos clients</p>
        </div>
        <button id="open-invoice-modal" class="btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nouvelle facture
        </button>
      </div>
      <div id="invoices-list" class="data-list"></div>
    </div>

    <!-- TAB: IMPRESSIONS 3D -->
    <div id="tab-prints" class="tab-pane" style="display:none">
      <div class="pane-header">
        <div>
          <h1>Impressions 3D</h1>
          <p class="pane-sub">Suivez les commandes d'impression de vos clients</p>
        </div>
        <button id="open-print-modal" class="btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nouvelle commande
        </button>
      </div>
      <div id="prints-list" class="data-list"></div>
    </div>

  </main>
</div>

<!-- MODAL CLIENT -->
<div id="client-modal" class="modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-head">
      <div>
        <h3 id="client-modal-title">Nouveau client</h3>
        <p class="modal-sub">Remplissez les informations du client</p>
      </div>
      <button class="modal-close" id="close-client-modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="client-form">
      <input type="hidden" id="c-edit-id" />
      <div class="mform-row">
        <div class="mfield"><label>Nom complet <span class="req">*</span></label><input type="text" id="c-name" placeholder="Jean Tremblay" required /></div>
        <div class="mfield"><label>Entreprise</label><input type="text" id="c-company" placeholder="Optionnel" /></div>
      </div>
      <div class="mform-row">
        <div class="mfield"><label>Courriel <span class="req">*</span></label><input type="email" id="c-email" placeholder="jean@exemple.com" required /></div>
        <div class="mfield"><label>Téléphone</label><input type="tel" id="c-phone" placeholder="514-000-0000" /></div>
      </div>
      <div class="mfield">
        <label>Mot de passe portail <span class="req">*</span></label>
        <input type="text" id="c-password" placeholder="Mot de passe pour accéder au portail" required />
        <small>Le client utilisera ce mot de passe sur nova-studio.ca/portal</small>
      </div>
      <div class="modal-foot">
        <button type="button" id="cancel-client" class="btn-ghost">Annuler</button>
        <button type="submit" class="btn-primary" id="save-client-btn">Enregistrer le client</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL FACTURE -->
<div id="invoice-modal" class="modal-overlay" style="display:none">
  <div class="modal modal-wide">
    <div class="modal-head">
      <div>
        <h3 id="invoice-modal-title">Nouvelle facture</h3>
        <p class="modal-sub">Créez une facture avec TPS/TVQ du Québec</p>
      </div>
      <button class="modal-close" id="close-invoice-modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="invoice-form">
      <input type="hidden" id="inv-edit-id" />
      <div class="mform-row">
        <div class="mfield">
          <label>Client <span class="req">*</span></label>
          <select id="inv-client" required><option value="">Choisir un client...</option></select>
        </div>
        <div class="mfield">
          <label>Numéro de facture <span class="req">*</span></label>
          <input type="text" id="inv-number" placeholder="NOVA-202601-001" required />
        </div>
      </div>
      <div class="mfield">
        <label>Description <span class="req">*</span></label>
        <input type="text" id="inv-title" placeholder="ex: Création site web vitrine" required />
      </div>

      <div class="items-block">
        <div class="items-block-head">
          <p class="items-block-title">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            Lignes de facturation
          </p>
          <button type="button" id="add-item-btn" class="btn-add-line">+ Ajouter une ligne</button>
        </div>
        <div class="items-cols-header">
          <span>Description</span><span>Qté</span><span>Prix unitaire</span><span>Total</span><span></span>
        </div>
        <div id="inv-items"></div>
      </div>

      <div class="tax-block">
        <p class="tax-block-title">Taxes applicables</p>
        <div class="tax-options">
          <label class="tax-toggle">
            <input type="checkbox" id="apply-tps" checked />
            <div class="tax-toggle-content">
              <span class="tax-name">TPS</span>
              <span class="tax-rate">5 %</span>
            </div>
          </label>
          <label class="tax-toggle">
            <input type="checkbox" id="apply-tvq" checked />
            <div class="tax-toggle-content">
              <span class="tax-name">TVQ</span>
              <span class="tax-rate">9,975 %</span>
            </div>
          </label>
        </div>
      </div>

      <div class="totals-block">
        <div class="totals-row"><span>Sous-total</span><strong id="disp-subtotal">0,00 $</strong></div>
        <div class="totals-row sub" id="row-tps"><span>TPS (5 %)</span><span id="disp-tps">0,00 $</span></div>
        <div class="totals-row sub" id="row-tvq"><span>TVQ (9,975 %)</span><span id="disp-tvq">0,00 $</span></div>
        <div class="totals-row grand"><span>TOTAL</span><strong id="disp-total">0,00 $</strong></div>
      </div>

      <div class="mform-row">
        <div class="mfield">
          <label>Date d'échéance</label>
          <input type="date" id="inv-due" />
        </div>
        <div class="mfield">
          <label>Statut</label>
          <select id="inv-status">
            <option value="pending">⏳ En attente</option>
            <option value="paid">✅ Payée</option>
            <option value="overdue">🔴 En retard</option>
            <option value="cancelled">❌ Annulée</option>
          </select>
        </div>
      </div>
      <div class="mfield">
        <label>Notes internes</label>
        <textarea id="inv-notes" rows="2" placeholder="Conditions de paiement, notes additionnelles..."></textarea>
      </div>
      <div class="modal-foot">
        <button type="button" id="cancel-invoice" class="btn-ghost">Annuler</button>
        <button type="submit" class="btn-primary" id="save-invoice-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Enregistrer la facture
        </button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL IMPRESSION 3D -->
<div id="print-modal" class="modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-head">
      <div>
        <h3 id="print-modal-title">Nouvelle commande</h3>
        <p class="modal-sub">Commande d'impression 3D</p>
      </div>
      <button class="modal-close" id="close-print-modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="print-form">
      <input type="hidden" id="p-edit-id" />
      <div class="mform-row">
        <div class="mfield">
          <label>Nom du client <span class="req">*</span></label>
          <input type="text" id="p-client" placeholder="Jean Tremblay" required />
        </div>
        <div class="mfield">
          <label>Prix <span class="req">*</span></label>
          <input type="number" id="p-price" min="0" step="0.01" placeholder="25.00" required />
        </div>
      </div>
      <div class="mfield">
        <label>Description de l'impression <span class="req">*</span></label>
        <input type="text" id="p-desc" placeholder="ex: Figurine dragon 15cm, remplis 20%" required />
      </div>
      <div class="mfield">
        <label>Statut</label>
        <select id="p-status">
          <option value="todo">📋 À commencer</option>
          <option value="in_progress">🔄 En cours</option>
          <option value="done">✅ Terminé</option>
          <option value="paid">💰 Payé</option>
        </select>
      </div>
      <div class="mfield">
        <label>Notes</label>
        <textarea id="p-notes" rows="2" placeholder="Couleur du filament, détails spéciaux..."></textarea>
      </div>
      <div class="modal-foot">
        <button type="button" id="cancel-print" class="btn-ghost">Annuler</button>
        <button type="submit" class="btn-primary" id="save-print-btn">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

</Layout>

<script>
import { createClient } from '@supabase/supabase-js';
const SB_URL = 'https://gnpjilwdehxsafdqdtak.supabase.co';
const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImducGppbHdkZWh4c2FmZHFkdGFrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk5Nzk3NjIsImV4cCI6MjA5NTU1NTc2Mn0.iFYR9r5ZZsKcc9n2N8jPtFTLs0QDTIqR3KMCMhCdSdA';
const sb = createClient(SB_URL, SB_KEY);
const ADMIN_PWD = 'nova2025';

const lock = document.getElementById('lock-screen') as HTMLElement;
const app  = document.getElementById('admin-app')  as HTMLElement;
const pwdIn  = document.getElementById('pwd')     as HTMLInputElement;
const pwdBtn = document.getElementById('pwd-btn') as HTMLButtonElement;
const pwdErr = document.getElementById('pwd-err') as HTMLElement;

if (sessionStorage.getItem('nova-admin') === '1') { lock.style.display = 'none'; app.style.display = 'flex'; init(); }

pwdBtn?.addEventListener('click', () => {
  if (pwdIn.value === ADMIN_PWD) { sessionStorage.setItem('nova-admin','1'); lock.style.display='none'; app.style.display='flex'; init(); }
  else { pwdErr.textContent = 'Mot de passe incorrect'; pwdIn.classList.add('shake'); setTimeout(()=>pwdIn.classList.remove('shake'),400); }
});
pwdIn?.addEventListener('keydown', e => e.key === 'Enter' && pwdBtn?.click());
document.getElementById('logout-btn')?.addEventListener('click', () => { sessionStorage.removeItem('nova-admin'); location.reload(); });

document.querySelectorAll('.snav-item').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.snav-item').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(t => (t as HTMLElement).style.display = 'none');
    btn.classList.add('active');
    const tab = (btn as HTMLElement).dataset.tab!;
    document.getElementById(`tab-${tab}`)!.style.display = 'block';
    if (tab === 'invoices') loadInvoices();
    if (tab === 'clients')  loadClients();
    if (tab === 'reviews')  loadReviews();
    if (tab === 'prints')   loadPrints();
  });
});

async function hashPwd(pwd: string) {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(pwd + 'nova-studio-salt'));
  return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join('');
}

const fmt = (n: number) => n.toLocaleString('fr-CA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' $';
let allClients: any[] = [];

async function init() { await loadClients(); await loadStats(); }

async function loadStats() {
  const [{ data: clients }, { data: invoices }] = await Promise.all([
    sb.from('nova_clients').select('id'),
    sb.from('nova_invoices').select('total, status'),
  ]);
  const pending = invoices?.filter(i => i.status === 'pending').reduce((s, i) => s + parseFloat(i.total), 0) || 0;
  const paid    = invoices?.filter(i => i.status === 'paid').reduce((s, i) => s + parseFloat(i.total), 0) || 0;
  const overdue = invoices?.filter(i => i.status === 'overdue').length || 0;
  const el = document.getElementById('admin-stats');
  if (!el) return;
  el.innerHTML = `
    <div class="stat-card">
      <div class="stat-icon sc-blue"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
      <div><p class="sc-val">${clients?.length || 0}</p><p class="sc-lbl">Clients actifs</p></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon sc-purple"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
      <div><p class="sc-val">${invoices?.length || 0}</p><p class="sc-lbl">Factures total</p></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon sc-amber"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
      <div><p class="sc-val">${fmt(pending)}</p><p class="sc-lbl">En attente</p></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon sc-green"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div>
      <div><p class="sc-val">${fmt(paid)}</p><p class="sc-lbl">Encaissé</p></div>
    </div>
  `;
}

async function loadClients() {
  const { data } = await sb.from('nova_clients').select('*').order('created_at', { ascending: false });
  allClients = data || [];
  renderClients();
  await loadStats();
  const sel = document.getElementById('inv-client') as HTMLSelectElement;
  if (sel) sel.innerHTML = '<option value="">Choisir un client...</option>' +
