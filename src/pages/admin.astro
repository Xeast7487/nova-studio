async function loadPrints() {
  const { data } = await sb.from('nova_prints').select('*').order('created_at', { ascending: false });
  const el = document.getElementById('prints-list'); if (!el) return;
  if (!data?.length) {
    el.innerHTML = '<div class="empty-state"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg><p>Aucune commande</p><small>Cliquez sur "Nouvelle commande" pour commencer</small></div>';
    return;
  }
  el.innerHTML = data.map((p: any) => `
    <div class="data-row">
      <div class="dr-avatar print-avatar">${p.client_name.charAt(0).toUpperCase()}</div>
      <div class="dr-main">
        <p class="dr-name">${p.client_name}</p>
        <p class="dr-meta">${p.description}${p.notes ? ` · ${p.notes}` : ''}</p>
      </div>
      <span class="status-pill ${PRINT_STATUS_CSS[p.status]}">${PRINT_STATUS[p.status]}</span>
      <p class="dr-amount">${fmt(parseFloat(p.price))}</p>
      <div class="dr-actions">
        <button class="action-btn action-default" onclick="editPrint('${p.id}')">Modifier</button>
        <button class="action-btn action-danger"  onclick="deletePrint('${p.id}')">Supprimer</button>
      </div>
    </div>
  `).join('');
}

(window as any).editPrint = async (id: string) => {
  const { data: p } = await sb.from('nova_prints').select('*').eq('id', id).single(); if (!p) return;
  (document.getElementById('p-edit-id') as HTMLInputElement).value  = p.id;
  (document.getElementById('p-client')  as HTMLInputElement).value  = p.client_name;
  (document.getElementById('p-desc')    as HTMLInputElement).value  = p.description;
  (document.getElementById('p-price')   as HTMLInputElement).value  = p.price;
  (document.getElementById('p-status')  as HTMLSelectElement).value = p.status;
  (document.getElementById('p-notes')   as HTMLTextAreaElement).value = p.notes || '';
  (document.getElementById('print-modal-title') as HTMLElement).textContent = 'Modifier la commande';
  openModal('print-modal');
};

(window as any).deletePrint = async (id: string) => {
  if (!confirm('Supprimer cette commande ?')) return;
  await sb.from('nova_prints').delete().eq('id', id); await loadPrints();
};

function resetPrintForm() {
  (document.getElementById('p-edit-id') as HTMLInputElement).value = '';
  (document.getElementById('print-form') as HTMLFormElement).reset();
  (document.getElementById('print-modal-title') as HTMLElement).textContent = 'Nouvelle commande';
}
</script>

